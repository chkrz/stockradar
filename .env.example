# StockRadar 抓取号配置(复制为 .env 后填写)
# cookie 来自你的一个 X 小号,twscrape 用它登录调接口。

# 小号 handle(不带@),仅作标识
X_ACCOUNT_USERNAME=your_handle_here

# 两个关键 cookie(必填,从浏览器 DevTools > Application > Cookies > x.com 拿)
X_AUTH_TOKEN=
X_CT0=

# 可选(cookie失效时用于重登,当前X风控严,主要靠cookie)
X_PASSWORD=
X_EMAIL=
X_EMAIL_PASSWORD=

# 可选:代理(降低封号风险)
X_PROXY=
